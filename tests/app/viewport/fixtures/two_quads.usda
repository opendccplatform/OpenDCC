(
    defaultPrim = "Mesh"
)

def Mesh "Mesh"
{
    point3f[] points = [(-3, -1, 1), (-2, -1, 1), (-1, -1, 1), (-3, 1, 1), (-2, 1, 1), (-1, 1, 1)]
    int[] faceVertexCounts = [4, 4]
    # The shared vertical edge has half-edge IDs 1 and 7.
    int[] faceVertexIndices = [0, 1, 4, 3, 1, 2, 5, 4]
    uniform token subdivisionScheme = "none"
}
