			</native-to-target>
			<target-to-native>
				<add-conversion type="@DCC_PXR_TS_NS@::SdfPath" check="PXR_BOOST_PYTHON_NAMESPACE::extract&lt;pxr::SdfPath&gt;(%in).check()">
