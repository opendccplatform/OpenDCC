					if (ex.check())
					%out=ex();
					else
					%out=pxr::SdfPath();
				</add-conversion>
			</target-to-native>
		</conversion-rule>
	</primitive-type>
    <namespace-type name="OpenDCC" generate="no">
        <object-type name="OIIOThumbnailCache"/>
        <object-type name="UsdLiveNodeItem"/>
        <object-type name="PropertyLayoutItem"/>
        <object-type name="PropertyWithPortsLayoutItem"/>
