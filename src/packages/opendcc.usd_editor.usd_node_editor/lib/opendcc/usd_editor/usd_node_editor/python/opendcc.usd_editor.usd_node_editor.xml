<?xml version="1.0"?>
<typesystem package="opendcc.usd_editor.usd_node_editor._usd_node_editor">

    <load-typesystem name="typesystem_core.xml" generate="no"/>
    <load-typesystem name="typesystem_gui.xml" generate="no"/>
    <load-typesystem name="typesystem_widgets.xml" generate="no"/>
    <load-typesystem name="typesystem_widgets.xml" generate="no"/>
	<load-typesystem name="opendcc.ui.node_editor.xml" generate="no"/>

	<primitive-type name="@DCC_PXR_TS_NS@::UsdPrim" target-name="UsdPrim">
		<include file-name="opendcc/base/pybind_bridge/boost_python.h" location="global"/>
		<conversion-rule>
			<native-to-target>
				auto obj = PXR_BOOST_PYTHON_NAMESPACE::object(%in);
				Py_IncRef(obj.ptr());
				return obj.ptr();
			</native-to-target>
			<target-to-native>
				<add-conversion type="@DCC_PXR_TS_NS@::UsdPrim" check="PXR_BOOST_PYTHON_NAMESPACE::extract&lt;pxr::UsdPrim&gt;(%in).check()">
					PXR_BOOST_PYTHON_NAMESPACE::extract&lt;pxr::UsdPrim&gt; ex(%in);
					if (ex.check())
					    %out=ex();
					else
					    %out=pxr::UsdPrim();
				</add-conversion>
			</target-to-native>
		</conversion-rule>
	</primitive-type>
	<primitive-type name="@DCC_PXR_TS_NS@::TfToken" target-name="TfToken">
		<include file-name="opendcc/base/pybind_bridge/boost_python.h" location="global"/>
		<conversion-rule>
			<native-to-target>
				auto obj = PXR_BOOST_PYTHON_NAMESPACE::object(%in);
				Py_IncRef(obj.ptr());
				return obj.ptr();
			</native-to-target>
			<target-to-native>
				<add-conversion type="@DCC_PXR_TS_NS@::TfToken" check="PXR_BOOST_PYTHON_NAMESPACE::extract&lt;pxr::TfToken&gt;(%in).check()">
					PXR_BOOST_PYTHON_NAMESPACE::extract&lt;pxr::TfToken&gt; ex(%in);
					if (ex.check())
						%out=ex();
					else
						%out=pxr::TfToken();
				</add-conversion>
			</target-to-native>
		</conversion-rule>
	</primitive-type>
	
	<primitive-type name="@DCC_PXR_TS_NS@::SdfPath" target-name="SdfPath">
		<include file-name="opendcc/base/pybind_bridge/boost_python.h" location="global"/>
		<conversion-rule>
			<native-to-target>
				auto obj = PXR_BOOST_PYTHON_NAMESPACE::object(%in);
				Py_IncRef(obj.ptr());
